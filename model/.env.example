model_provider=ollama
model_id=your-installed-local-model
ollama_base_url=http://localhost:11434
temperature=0.7
max_tokens=512
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
LANGCHAIN_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# Alternative patient-generation provider; replace model_provider/model_id above.
# model_provider=vertex_ai
# model_id=your-accessible-vertex-model
# GCP_PROJECT=your-project-id
# GCP_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/credentials.json
