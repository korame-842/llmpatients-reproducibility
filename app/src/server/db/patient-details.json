      "type": "object",
      "title": "Meccanismi di Coping e Difese",
      "additionalProperties": false,
      "properties": {
        "coping_strategies": {
          "type": "string",
          "title": "Strategie di coping"
        },
        "defense_mechanisms": {
          "type": "string",
          "title": "Meccanismi di difesa"
        }
      }
    },
    "dysfunctional_behaviors_and_risk": {
      "type": "object",
      "title": "Condotte Disfunzionali e Comportamenti a Rischio",
      "additionalProperties": false,
      "properties": {
        "self_harm_and_suicidality": {
          "type": "string",
