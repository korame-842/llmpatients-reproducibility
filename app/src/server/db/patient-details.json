      "type": "object",
      "title": "Resilienza e Benessere Psicologico",
      "additionalProperties": false,
      "properties": {
        "psychological_resilience": {
          "type": "string",
          "title": "Resilienza psicologica"
        },
        "self_compassion": {
          "type": "string",
          "title": "Autocompassione"
        },
        "life_satisfaction": {
          "type": "string",
          "title": "Soddisfazione della vita"
        },
        "personal_growth": {
          "type": "string",
          "title": "Crescita personale"
        },
        "sense_of_coherence": {
          "type": "string",
          "title": "Senso di coerenza"
        },
        "sense_of_control_or_empowerment": {
          "type": "string",
          "title": "Senso di controllo o empowerment"
        },
        "hope_for_future": {
          "type": "string",
          "title": "Speranza per il futuro"
        },
        "long_term_life_goals": {
          "type": "string",
          "title": "Obiettivi di vita a lungo termine"
        }
      }
