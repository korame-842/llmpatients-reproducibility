      "additionalProperties": false,
      "properties": {
        "previous_therapeutic_experiences": {
          "type": "string",
          "title": "Esperienze terapeutiche pregresse"
        },
        "treatment_progress_and_resistance": {
          "type": "string",
          "title": "Progresso e resistenza"
        },
        "therapeutic_goals": {
          "type": "string",
          "title": "Obiettivi terapeutici"
        },
        "pharmacological_history": {
          "type": "string",
          "title": "Storia farmacologica"
        },
        "medication_response": {
          "type": "string",
          "title": "Risposta ai farmaci"
        },
        "hospitalization_history": {
          "type": "string",
          "title": "Pregressi ricoveri"
        },
        "hospitalization_details": {
          "type": "string",
          "title": "Storia di ospedalizzazioni"
        },
        "emergency_room_visits": {
          "type": "string",
          "title": "Accessi visite al pronto soccorso"
        },
        "historical_psychiatric_diagnoses": {
          "type": "string",
          "title": "Diagnosi psichiatriche pregresse"
        }
      }
