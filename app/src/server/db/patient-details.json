      "type": "object",
      "title": "Profilo Psicologico e Funzionamento Cognitivo",
      "additionalProperties": false,
      "properties": {
        "current_and_past_psychiatric_diagnoses": {
          "type": "string",
          "title": "Diagnosi psichiatriche in corso e pregresse"
        },
        "main_symptoms": {
          "type": "string",
          "title": "Sintomi principali"
        },
        "emotional_reactions_and_mood": {
          "type": "string",
          "title": "Reazioni emotive e area dell'umore"
        },
        "auto_hetero_directed_aggression": {
          "type": "string",
