        },
        "cognitive_style": {
          "type": "string",
          "title": "Stile cognitivo"
        },
        "cognitive_schemas": {
          "type": "string",
          "title": "Schemi cognitivi"
        },
        "attachment_style": {
          "type": "string",
          "title": "Stile di attaccamento"
        },
        "executive_functioning": {
          "type": "string",
          "title": "Funzionamento esecutivo"
        },
        "memory": {
          "type": "string",
          "title": "Memoria"
        },
        "attention_and_concentration": {
          "type": "string",
          "title": "Attenzione e concentrazione"
        },
        "sensory_perception": {
          "type": "string",
          "title": "Percezione sensoriale"
        },
        "higher_cognitive_functions": {
          "type": "string",
          "title": "Funzioni cognitive superiori"
        }
      }
