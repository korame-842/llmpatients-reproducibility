      "type": "object",
      "title": "Relazioni Sociali e Interazioni",
      "additionalProperties": false,
      "properties": {
        "friendships": {
          "type": "string",
          "title": "Amicizie"
        },
        "romantic_relationships": {
          "type": "string",
          "title": "Relazioni romantiche"
        },
        "sexual_relationships": {
          "type": "string",
          "title": "Relazioni sessuali"
        },
        "family_interactions": {
          "type": "string",
          "title": "Interazioni familiari"
        },
        "peer_and_colleague_relationships": {
          "type": "string",
