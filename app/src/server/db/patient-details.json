      "additionalProperties": false,
      "properties": {
        "pre_existing_medical_conditions": {
          "type": "string",
          "title": "Condizioni mediche preesistenti"
        },
        "pharmacological_treatments": {
          "type": "string",
          "title": "Trattamenti farmacologici"
        },
        "allergies": {
          "type": "string",
          "title": "Allergie"
        },
        "lifestyle": {
          "type": "string",
          "title": "Stile di vita"
        },
        "general_physical_health": {
          "type": "string",
          "title": "Salute fisica generale"
        },
        "sleep_patterns": {
          "type": "string",
          "title": "Schemi di sonno"
        },
        "eating_habits": {
          "type": "string",
          "title": "Abitudini alimentari"
        }
      }
