{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Structured Psychological Assessment Schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "demographic_sociocultural_information": {
      "type": "object",
      "title": "Informazioni Demografiche e Socioculturali",
      "additionalProperties": false,
      "properties": {
        "age": {
          "type": "string",
          "title": "Eta"
        },
        "gender": {
          "type": "string",
          "title": "Genere"
        },
        "marital_status": {
          "type": "string",
          "title": "Stato civile"
        },
        "cultural_background": {
          "type": "string",
          "title": "Background culturale"
        },
        "religious_beliefs": {
          "type": "string",
          "title": "Credenze religiose"
        },
        "spoken_language": {
          "type": "string",
          "title": "Lingua parlata"
        },
        "migration_status": {
          "type": "string",
          "title": "Stato migratorio"
        }
      }
    },
    "family_social_history": {
      "type": "object",
      "title": "Storia Contesto Familiare e Sociale",
      "additionalProperties": false,
      "properties": {
        "developmental_family_dynamics": {
          "type": "string",
          "title": "Dinamiche familiari in eta evolutiva"
        },
        "current_parent_relationships": {
          "type": "string",
          "title": "Relazioni attuali con i genitori"
        },
        "childhood_experiences": {
          "type": "string",
          "title": "Esperienze infantili"
        },
        "abuse_history": {
          "type": "string",
          "title": "Storia di abusi"
        }
      }
    },
    "family_social_context": {
      "type": "object",
      "title": "Contesto Familiare e Sociale",
      "additionalProperties": false,
      "properties": {
        "social_support_overview": {
          "type": "string",
          "title": "Supporto sociale"
        },
        "support_network": {
          "type": "string",
          "title": "Rete di supporto"
        }
      }
    },
    "education_and_employment": {
      "type": "object",
      "title": "Formazione e Occupazione",
      "additionalProperties": false,
      "properties": {
        "education_level": {
          "type": "string",
          "title": "Livello di istruzione"
