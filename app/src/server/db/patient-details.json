        },
        "substance_abuse": {
          "type": "string",
          "title": "Abuso di sostanze"
        },
        "avoidance_behaviors": {
          "type": "string",
          "title": "Evitamento"
        },
        "impulsive_and_risky_behaviors": {
          "type": "string",
          "title": "Comportamenti impulsivi e a rischio"
        },
        "morality": {
          "type": "string",
          "title": "Moralita"
        }
      }
    },
