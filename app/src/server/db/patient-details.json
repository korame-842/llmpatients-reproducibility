      "type": "object",
      "title": "Contesto Sociale e Ambientale",
      "additionalProperties": false,
      "properties": {
        "community_social_support": {
          "type": "string",
          "title": "Supporto sociale"
        },
        "housing_conditions": {
          "type": "string",
          "title": "Condizioni abitative"
        },
        "social_security": {
          "type": "string",
          "title": "Sicurezza sociale"
        },
        "social_cohesion": {
          "type": "string",
          "title": "Coesione sociale"
        },
        "social_determinants_of_mental_health": {
          "type": "string",
          "title": "Determinanti sociali della salute mentale"
        }
      }
    },
    "test_session_behavior": {
      "type": "object",
      "title": "Comportamento Durante la Somministrazione del Test",
      "additionalProperties": false,
      "properties": {
        "recurring_dynamics": {
          "type": "string",
          "title": "Dinamiche ricorrenti (transfert e controtransfert; es. Manipolativita, sottomissione, svalutazione, evitamento etc.)"
        },
        "prevalent_emotions": {
          "type": "string",
          "title": "Emozioni prevalenti"
        },
        "speech_characteristics": {
          "type": "string",
          "title": "Tono, fluenza, coerenza, contenuto e ritmo dell'eloquio"
        },
        "nonverbal_communication": {
          "type": "string",
          "title": "Contatto visivo, postura, gestualita"
        }
      }
    }
