# Synthetic local-review configuration; use a dedicated PostgreSQL server.
DATABASE_URL="postgresql://postgres:reviewer-demo-password@127.0.0.1:16543/postgres"
AUTH_SECRET="reviewer-demo-auth-secret-0000000000000000"
NEXTAUTH_SECRET="reviewer-demo-auth-secret-0000000000000000"
NEXTAUTH_URL="http://localhost:18080"
API="local"
TTS_PROVIDER="none"

# Optional: connect to the separately supplied Agent instead of the local mock.
# API="remote"
# API_BASE_URL="http://127.0.0.1:8000"
# API_INITIALIZE_PATIENT_ENDPOINT="/patients"

